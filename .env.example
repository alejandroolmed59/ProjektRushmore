# Discord
TOKEN=
CLIENT_ID=
GUILD_ID=

# AWS / DynamoDB
AWS_REGION=
GAMBLE_TABLE_NAME=
GAMBLERS_MONEY_TABLE_NAME=
PREDICTION_HISTORY_TABLE_NAME=
GAMBLER_ROLE_ID=

# Football "shitpost" relocator
# User whose football/soccer messages get moved.
SHITPOST_USER_ID=
# Channel they get moved into.
SHITPOST_TARGET_CHANNEL_ID=
# Custom emoji ID (or unicode emoji); 2 reactions force a football re-check.
SHITPOST_TRIGGER_EMOJI=

# Work/fatigue detector: watched user(s) and the custom emoji ID used as both
# the trigger reaction and the reply.
FATIGUE_USER_ID=
JB_FATIGUE_EMOJI=

# TypeSafe (Jev) classifier used by the football and work detectors.
TYPESAFE_API_KEY=
# Optional, defaults to jev-1.13.0 (pinned so the threshold stays meaningful)
TYPESAFE_DEFAULT_MODEL=
# Optional, probability of "yes" needed to act; defaults to 0.5
TYPESAFE_THRESHOLD=

# Reminders/debts: channel where charges and nags are posted (optional,
# defaults to the channel the command was run in).
REMINDERS_CHANNEL_ID=
# Optional, defaults to data/rushmore.db
SQLITE_PATH=

# Google AI Studio API key; only used by the keyword-extraction script below.
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=

# Optional: only used by src/scripts/analyze-user-history.ts (tuning script)
# ANALYZE_CHANNEL_ID=
# ANALYZE_MAX_MESSAGES=1000
# ANALYZE_CLASSIFY=true
